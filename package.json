{
  "name": "tipjar-dapp",
  "version": "1.0.0",
  "description": "On-chain Tip Jar contract + frontend, deployed on Ethereum Sepolia",
  "scripts": {
    "dev": "npm run --prefix frontend-nextjs dev",
    "build": "npm run --prefix frontend-nextjs build",
    "start": "npm run --prefix frontend-nextjs start",
    "lint": "npm run --prefix frontend-nextjs lint",
    "typecheck": "npm run --prefix frontend-nextjs typecheck",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.5"
  },
  "license": "MIT"
}
