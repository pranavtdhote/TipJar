# Deployed TipJar contract address (from `npx hardhat run scripts/deploy.js --network sepolia`)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedTipJarAddressHere

# Public read-only Sepolia RPC used for the live feed before/without a wallet connected.
# You can point this at your QuickNode endpoint too, but a public one avoids exposing
# your QuickNode URL/rate limits to every visitor's browser.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
